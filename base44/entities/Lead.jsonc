{
  "name": "Lead",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Where the visitor came from, e.g. a persona link (?src=naetalks) or 'site'."
    },
    "intent": {
      "type": "string",
      "enum": [
        "hot",
        "warm"
      ],
      "default": "warm"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "won",
        "lost"
      ],
      "default": "new"
    },
    "transcript": {
      "type": "string",
      "description": "Chat transcript captured by the edge sales concierge."
    }
  },
  "required": [
    "email"
  ]
}
