{
  "name": "TaskTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template label, also used as the default task title when launched."
    },
    "description": {
      "type": "string",
      "description": "Short summary of what this recurring workflow does."
    },
    "instructions": {
      "type": "string",
      "description": "Pre-filled agent instructions / prompt applied to every launched task."
    },
    "category": {
      "type": "string",
      "enum": [
        "Sales",
        "Content",
        "Creative",
        "Fulfillment",
        "Growth",
        "Ops"
      ],
      "default": "Ops"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "agent": {
      "type": "string",
      "description": "Default agent name to assign on launch."
    },
    "revenue_impact": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}