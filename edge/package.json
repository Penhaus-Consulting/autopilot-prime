{
  "name": "penhaus-edge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check && npm run typecheck && wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.155.0"
  }
}
